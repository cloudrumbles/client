+//! Scratch port: an explicit RAM filesystem for a single browser authority worker.
+//! Native storage remains Tokio; persistence to OPFS is a separate, unimplemented adapter.
+#[cfg(not(target_arch = "wasm32"))]
+pub use tokio::fs::*;
+#[cfg(target_arch = "wasm32")]
+mod ram {
+ use std::{collections::BTreeMap,io::{self,SeekFrom},path::{Path,PathBuf},pin::Pin,sync::{Arc,Mutex,MutexGuard,OnceLock},task::{Context,Poll}};
+ use tokio::io::{AsyncRead,AsyncSeek,AsyncWrite,ReadBuf};
+ type Data=Arc<Mutex<Vec<u8>>>;
+ static FILES:OnceLock<Mutex<BTreeMap<PathBuf,Data>>>=OnceLock::new();
+ fn lock<T>(value:&Mutex<T>)->MutexGuard<'_,T>{value.lock().unwrap_or_else(std::sync::PoisonError::into_inner)}
+ fn files()->MutexGuard<'static,BTreeMap<PathBuf,Data>>{lock(FILES.get_or_init(||Mutex::new(BTreeMap::new())))}
+ pub async fn read(path:impl AsRef<Path>)->io::Result<Vec<u8>> {
+  let data=files().get(path.as_ref()).cloned().ok_or(io::ErrorKind::NotFound)?;
+  let result=lock(&data).clone();Ok(result)
+ }
+ pub async fn write(path:impl AsRef<Path>,contents:impl AsRef<[u8]>)->io::Result<()> {
+  let data=files().entry(path.as_ref().to_owned()).or_insert_with(||Arc::new(Mutex::new(Vec::new()))).clone();
+  let mut bytes=lock(&data);bytes.clear();bytes.extend_from_slice(contents.as_ref());Ok(())
+ }
+ pub async fn rename(from:impl AsRef<Path>,to:impl AsRef<Path>)->io::Result<()> {
+  let mut map=files();let data=map.remove(from.as_ref()).ok_or(io::ErrorKind::NotFound)?;
+  map.insert(to.as_ref().to_owned(),data);Ok(())
+ }
+ pub struct File{data:Data,position:u64,append:bool,read:bool,write:bool}
+ pub struct Metadata(u64);impl Metadata{pub fn len(&self)->u64{self.0}}
+ impl File {
+  pub async fn metadata(&self)->io::Result<Metadata>{Ok(Metadata(lock(&self.data).len()as u64))}
+  pub async fn create(path:impl AsRef<Path>)->io::Result<Self>{OpenOptions::new().write(true).create(true).truncate(true).open(path).await}
+ }
+ #[derive(Default)]pub struct OpenOptions{read:bool,write:bool,create:bool,truncate:bool,append:bool}
+ impl OpenOptions {
+  pub fn new()->Self{Self::default()}
+  pub fn read(&mut self,value:bool)->&mut Self{self.read=value;self}
+  pub fn write(&mut self,value:bool)->&mut Self{self.write=value;self}
+  pub fn create(&mut self,value:bool)->&mut Self{self.create=value;self}
+  pub fn truncate(&mut self,value:bool)->&mut Self{self.truncate=value;self}
+  pub fn append(&mut self,value:bool)->&mut Self{self.append=value;self}
+  pub async fn open(&self,path:impl AsRef<Path>)->io::Result<File>{
+   if !self.write && !self.read{return Err(io::ErrorKind::PermissionDenied.into());}
+   let mut map=files();let data=match map.get(path.as_ref()){Some(data)=>Arc::clone(data),None if self.create=>{let data=Arc::new(Mutex::new(Vec::new()));map.insert(path.as_ref().to_owned(),Arc::clone(&data));data},None=>return Err(io::ErrorKind::NotFound.into())};
+   if self.truncate{lock(&data).clear();}Ok(File{data,position:0,append:self.append,read:self.read,write:self.write})
+  }
+ }
+ impl AsyncRead for File {
+  fn poll_read(mut self:Pin<&mut Self>,_:&mut Context<'_>,target:&mut ReadBuf<'_>)->Poll<io::Result<()>>{
+   if !self.read{return Poll::Ready(Err(io::ErrorKind::PermissionDenied.into()));}
+   let data=lock(&self.data);let start=usize::try_from(self.position).unwrap_or(usize::MAX).min(data.len());let count=target.remaining().min(data.len()-start);target.put_slice(&data[start..start+count]);drop(data);self.position+=count as u64;Poll::Ready(Ok(()))
+  }
+ }
+ impl AsyncWrite for File {
+  fn poll_write(mut self:Pin<&mut Self>,_:&mut Context<'_>,source:&[u8])->Poll<io::Result<usize>> {
+   if !self.write{return Poll::Ready(Err(io::ErrorKind::PermissionDenied.into()));}
+   let mut data=lock(&self.data);let start=if self.append{data.len()}else{match usize::try_from(self.position){Ok(value)=>value,Err(_)=>return Poll::Ready(Err(io::ErrorKind::InvalidInput.into()))}};
+   let Some(end)=start.checked_add(source.len())else{return Poll::Ready(Err(io::ErrorKind::InvalidInput.into()))};
+   if end>data.len(){data.resize(end,0);}data[start..end].copy_from_slice(source);drop(data);self.position=end as u64;Poll::Ready(Ok(source.len()))
+  }
+  fn poll_flush(self:Pin<&mut Self>,_:&mut Context<'_>)->Poll<io::Result<()>>{Poll::Ready(Ok(()))}
+  fn poll_shutdown(self:Pin<&mut Self>,_:&mut Context<'_>)->Poll<io::Result<()>>{Poll::Ready(Ok(()))}
+ }
+ impl AsyncSeek for File {
+  fn start_seek(mut self:Pin<&mut Self>,from:SeekFrom)->io::Result<()> {
+   let position=match from{SeekFrom::Start(value)=>i128::from(value),SeekFrom::Current(value)=>i128::from(self.position)+i128::from(value),SeekFrom::End(value)=>lock(&self.data).len()as i128+i128::from(value)};
+   self.position=u64::try_from(position).map_err(|_|io::Error::from(io::ErrorKind::InvalidInput))?;Ok(())
+  }
+  fn poll_complete(self:Pin<&mut Self>,_:&mut Context<'_>)->Poll<io::Result<u64>>{Poll::Ready(Ok(self.position))}
+ }
+}
+#[cfg(target_arch = "wasm32")]
+pub use ram::*;
